{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yui-stingray/agent-policy/schemas/agent-policy.audit_event.v1.schema.json",
  "title": "agent-policy audit event v1",
  "type": "object",
  "required": [
    "repo",
    "capability",
    "context",
    "decision"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "mode",
        "reason",
        "matched_repo"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "deny",
            "require_approval",
            "auto_allow"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "hard_guardrail",
            "repo_policy",
            "default_mode",
            "condition_match",
            "no_match"
          ]
        },
        "matched_repo": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@/+~-]+$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\x00-\\x1f][^\\x00-\\x1f]*$"
    }
  },
  "additionalProperties": false
}
